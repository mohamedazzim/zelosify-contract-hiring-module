# ============================================================
# Zelosify Backend — Sanitized environment example
# Copy to `.env` and fill in local values. NEVER commit real secrets.
# ============================================================

# PostgreSQL connection (host/port/db only — replace credentials)
DATABASE_URL=postgresql://replace_with_local_user:replace_with_local_password@localhost:5445/zelosify_recruit_test

# Keycloak (local dev realm)
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=zelosify
KEYCLOAK_CLIENT_ID=zelosify-dynamic-client
KEYCLOAK_CLIENT_SECRET=replace_with_local_secret
KEYCLOAK_RS256_SIG=replace_with_local_rs256_signature

# Session / JWT signing secrets (generate locally, never commit)
SESSION_SECRET=replace_with_local_secret
JWT_SECRET=replace_with_local_secret

# Server
PORT=5000
NODE_ENV=development

# Object storage (MinIO local or AWS S3)
STORAGE_PROVIDER=minio
S3_ENDPOINT=http://localhost:9000
S3_AWS_REGION=us-east-1
S3_ACCESS_KEY_ID=replace_with_local_secret
S3_SECRET_ACCESS_KEY=replace_with_local_secret
S3_BUCKET_NAME=zelosify-files

# LLM (optional at runtime; required for live AI recommendations)
GROQ_API_KEY=replace_with_local_secret
